# System and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.agents/

# Temp and backup files
*.tmp
*.bak
*.swp

# Dev debug dumps (optional large html pages & downloaded static files)
dev_resources/html/
dev_resources/data/
dev_resources/resources/
dev_resources/**/*.har

# 本地页面快照（含头像/用户名/做题记录等个人数据，永不入库）
dev_resources/snapshots/inbox/*
!dev_resources/snapshots/inbox/.gitkeep

# Environment and Security Sensitive Files (Secret Isolation)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
secrets/
credentials.json
*.log

